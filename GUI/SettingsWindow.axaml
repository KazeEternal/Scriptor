<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="GUI.SettingsWindow"
        Width="760"
        Height="220"
        MinWidth="560"
        MinHeight="200"
        Background="#1E1E1E"
        Foreground="#D4D4D4"
        Title="Scriptor Settings"
        WindowStartupLocation="CenterOwner"
        CanResize="False">
  <Grid RowDefinitions="Auto,*,Auto" Margin="14">
    <TextBlock Grid.Row="0" Text="Settings" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />

    <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto">
      <TextBlock Grid.Row="0" Grid.Column="0" Text="Scripts Folder" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0" />
      <TextBox Grid.Row="0" Grid.Column="1" x:Name="ScriptsPathTextBox" Watermark="D:\\Path\\To\\Scripts" />
      <Button Grid.Row="0" Grid.Column="2" x:Name="BrowseScriptsPathButton" Content="Browse" MinWidth="88" Margin="10,0,0,0" />
      <TextBlock Grid.Row="1" Grid.Column="1" x:Name="ValidationText" Foreground="#F44747" IsVisible="False" TextWrapping="Wrap" Margin="0,6,0,0" />
    </Grid>

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
      <Button x:Name="CancelButton" Content="Cancel" MinWidth="88" />
      <Button x:Name="SaveButton" Content="Save" MinWidth="88" />
    </StackPanel>
  </Grid>
</Window>
